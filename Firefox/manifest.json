{
  "manifest_version": 3,
  "browser_specific_settings": {
    "gecko": {
      "id": "{b01d3453-463e-44b2-8ad8-1d705bbac6ad}",
      "data_collection_permissions": {
        "required": ["browsingActivity"]
      }
    }
  },
  "name": "Fabasoft Time Tracker",
  "version": "1.0",
  "description": "Tracks your total time in Fabasoft Cloud, plus the time wasted waiting for the busy indicator",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["shared.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fabasoft Time Tracker"
  },
  "options_page": "settings.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
